{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.invalid/sea.future-policy-delivery-consumption-attempt-v1.schema.json",
 "title": "Prospective SEA policy-attempt delivery and consumption log",
 "description": "Future-only attempt/item schema. Unknown and not_attempted are explicit; no selected event implies delivery, opening, attendance, or consumption. Historical replay rows must not be backfilled without independent evidence.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "run_key",
  "attempt_id",
  "policy_record_id",
  "policy_execution",
  "items",
  "efficiency"
 ],
 "properties": {
  "schema_version": {
   "const": "sea.future-policy-delivery-consumption-attempt/v1"
  },
  "run_key": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "family",
    "run",
    "agent",
    "sim_day"
   ],
   "properties": {
    "family": {
     "type": "string",
     "minLength": 1
    },
    "run": {
     "type": "integer",
     "minimum": 1
    },
    "agent": {
     "type": "integer",
     "minimum": 0
    },
    "sim_day": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "attempt_id": {
   "type": "string",
   "minLength": 1
  },
  "policy_record_id": {
   "type": "string",
   "minLength": 1
  },
  "policy_execution": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "started_at",
    "ended_at",
    "execution_status",
    "parser_status",
    "transport_status",
    "empty_selection_reason",
    "raw_output_artifact_sha256"
   ],
   "properties": {
    "started_at": {
     "type": [
      "string",
      "null"
     ],
     "format": "date-time"
    },
    "ended_at": {
     "type": [
      "string",
      "null"
     ],
     "format": "date-time"
    },
    "execution_status": {
     "type": "string",
     "enum": [
      "success",
      "explicit_abstention",
      "parse_failure",
      "execution_failure",
      "transport_failure",
      "unknown"
     ]
    },
    "parser_status": {
     "type": "string",
     "enum": [
      "success",
      "failure",
      "not_attempted",
      "unknown"
     ]
    },
    "transport_status": {
     "type": "string",
     "enum": [
      "success",
      "failure",
      "not_attempted",
      "not_applicable",
      "unknown"
     ]
    },
    "empty_selection_reason": {
     "type": "string",
     "enum": [
      "not_applicable",
      "explicit_abstention",
      "parse_failure",
      "execution_failure",
      "transport_failure",
      "unknown"
     ]
    },
    "raw_output_artifact_sha256": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "items": {
   "type": "array",
   "description": "One entry per candidate item; empty selected lists remain distinguishable by policy_execution.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item_id",
     "selected",
     "delivered",
     "opened",
     "attended",
     "consumed"
    ],
    "properties": {
     "item_id": {
      "type": "string",
      "minLength": 1
     },
     "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "status",
       "event_id",
       "timestamp",
       "rank",
       "selection_source"
      ],
      "properties": {
       "status": {
        "type": "string",
        "enum": [
         "selected",
         "not_selected",
         "unknown"
        ]
       },
       "event_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "timestamp": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "rank": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "selection_source": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "delivered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "status",
       "event_id",
       "timestamp",
       "channel",
       "message_id",
       "error_code"
      ],
      "properties": {
       "status": {
        "type": "string",
        "enum": [
         "success",
         "failure",
         "not_attempted",
         "not_applicable",
         "unknown"
        ]
       },
       "event_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "timestamp": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "channel": {
        "type": [
         "string",
         "null"
        ]
       },
       "message_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "error_code": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "opened": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "status",
       "event_id",
       "timestamp",
       "instrument"
      ],
      "properties": {
       "status": {
        "type": "string",
        "enum": [
         "success",
         "failure",
         "not_attempted",
         "not_applicable",
         "unknown"
        ]
       },
       "event_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "timestamp": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "instrument": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "attended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "status",
       "event_id",
       "timestamp",
       "duration_ms",
       "instrument"
      ],
      "properties": {
       "status": {
        "type": "string",
        "enum": [
         "success",
         "failure",
         "not_attempted",
         "not_applicable",
         "unknown"
        ]
       },
       "event_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "timestamp": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "duration_ms": {
        "type": [
         "number",
         "null"
        ],
        "minimum": 0
       },
       "instrument": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "consumed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "status",
       "event_id",
       "timestamp",
       "duration_ms",
       "fraction",
       "instrument"
      ],
      "properties": {
       "status": {
        "type": "string",
        "enum": [
         "success",
         "failure",
         "not_attempted",
         "not_applicable",
         "unknown"
        ]
       },
       "event_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "timestamp": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "duration_ms": {
        "type": [
         "number",
         "null"
        ],
        "minimum": 0
       },
       "fraction": {
        "type": [
         "number",
         "null"
        ],
        "minimum": 0,
        "maximum": 1
       },
       "instrument": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
   }
  },
  "efficiency": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "measurement_status",
    "calls",
    "input_tokens",
    "output_tokens",
    "cost",
    "latency_ms",
    "retries"
   ],
   "properties": {
    "measurement_status": {
     "type": "string",
     "enum": [
      "complete",
      "partial",
      "unavailable"
     ]
    },
    "calls": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "input_tokens": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "output_tokens": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "cost": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "amount",
      "currency"
     ],
     "properties": {
      "amount": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 0
      },
      "currency": {
       "type": [
        "string",
        "null"
       ],
       "minLength": 3
      }
     }
    },
    "latency_ms": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "retries": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    }
   }
  }
 },
 "$comment": "Validation must additionally enforce timestamp order and prohibit downstream success after an upstream failure/not_attempted status. Nullable measurements require an explicit partial/unavailable measurement_status; null is not zero."
}
